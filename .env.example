# Copie para .env (nunca versione o .env). Valores aqui são exemplos.

# Token compartilhado entre web (proxy) e motor. Gere um longo: python -c "import secrets;print(secrets.token_urlsafe(32))"
STARK_API_TOKEN=troque-por-um-token-longo
# Chave p/ criptografar tokens OAuth das contas (Fernet derivada)
STARK_SECRET_KEY=troque-por-outra-chave-longa
POSTGRES_PASSWORD=troque-esta-senha

# Transcrição local (tiny|base|small|medium|large-v3). small = bom equilíbrio PT-BR em CPU.
STARK_WHISPER_MODEL=small
STARK_WHISPER_DEVICE=auto
STARK_LANGUAGE=pt
STARK_HWACCEL=auto

# Limites de upload
STARK_MAX_UPLOAD_MB=4096
STARK_MAX_DURATION_S=14400

# YouTube Data API v3 (busca/tendências; cota grátis diária no Google Cloud)
STARK_YOUTUBE_API_KEY=

# 100% grátis (padrão): bloqueia APIs pagas (Anthropic/OpenAI) no servidor. false = libera com orçamento.
STARK_FREE_ONLY=true

# IA opcional. Modo grátis aceita: Ollama local e Gemini free tier (chave de projeto SEM faturamento).
STARK_GEMINI_API_KEY=
STARK_ANTHROPIC_API_KEY=
STARK_OPENAI_API_KEY=
STARK_OLLAMA_URL=http://127.0.0.1:11434
